{
	"name": "careride-team-1",
	"compatibility_date": "2026-10-03",
	"main": "./worker/index.ts",
	// Dashboard deploy command: npm run deploy
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// /api/ota is the Android live-update check. npm run deploy zips dist/ into
		// dist/ota/ before Wrangler uploads, so the Worker can point phones at it.
		"run_worker_first": ["/api/*"]
	}
}
