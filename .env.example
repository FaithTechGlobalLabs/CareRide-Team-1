# Copy to .env.local (git-ignored) and fill in. Everything here is optional:
# without a key the app works as before, with plain "Directions" links to Google Maps.
# Setup steps: README.md, "Google Maps (optional)".

# Browser key with Maps JavaScript API and Routes API enabled, restricted by website.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. A Map ID from Google Cloud > Google Maps Platform > Map management. Defaults to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
