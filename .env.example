# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Restart `npm run dev` after changing it.

# 'mock' (localStorage demo) or 'supabase'. Keep 'mock' until the
# Supabase service is implemented.
VITE_DATA_BACKEND=mock

# From Supabase dashboard → Project Settings → API Keys.
# Only the PUBLISHABLE key belongs here. Never put the secret/service-role
# key, database password, or connection string in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
